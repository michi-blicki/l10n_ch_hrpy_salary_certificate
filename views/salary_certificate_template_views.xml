<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_l10n_ch_salary_certificate_template_tree" model="ir.ui.view">
        <field name="name">l10n.ch.salary.certificate.template.tree</field>
        <field name="model">l10n.ch.salary.certificate.template</field>
        <field name="arch" type="xml">
            <list string="Salary Certificate Templates" default_order="year desc,id desc">
                <field name="name"/>
                <field name="year"/>
                <field name="version"/>
                <field name="docversion"/>
                <field name="docinfo_lang_code"/>
                <field name="active"/>
            </list>
        </field>
    </record>

    <record id="view_l10n_ch_salary_certificate_template_search" model="ir.ui.view">
        <field name="name">l10n.ch.salary.certificate.template.search</field>
        <field name="model">l10n.ch.salary.certificate.template</field>
        <field name="arch" type="xml">
            <search string="Salary Certificate Templates">
                <field name="name"/>
                <field name="year"/>
                <field name="version"/>
                <field name="docversion"/>
                <field name="docinfo_lang_code"/>
                <filter name="filter_active" string="Active" domain="[('active', '=', True)]"/>
                <filter name="filter_inactive" string="Inactive" domain="[('active', '=', False)]"/>
                <separator/>
                <filter name="group_by_year" string="Year" context="{'group_by': 'year'}"/>
                <filter name="group_by_docversion" string="Docversion" context="{'group_by': 'docversion'}"/>
            </search>
        </field>
    </record>

    <record id="view_l10n_ch_salary_certificate_template_form" model="ir.ui.view">
        <field name="name">l10n.ch.salary.certificate.template.form</field>
        <field name="model">l10n.ch.salary.certificate.template</field>
        <field name="arch" type="xml">
            <form string="Salary Certificate Template">
                <header>
                    <button
                        name="%(l10n_ch_hrpy_salary_certificate.action_l10n_ch_import_official_template_wizard)d"
                        type="action"
                        string="Import Official PDF"
                        class="btn-primary"
                    />
                    <field name="active" widget="boolean_toggle"/>
                </header>
                <sheet>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="year"/>
                            <field name="version"/>
                            <field name="docversion"/>
                            <field name="docinfo_lang_code"/>
                            <field name="lang_ids" widget="many2many_tags"/>
                        </group>
                        <group>
                            <field name="official_pdf" filename="official_pdf_filename"/>
                            <field name="official_pdf_filename" invisible="1"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Formulas">
                            <field name="formula_line_ids">
                                <list editable="bottom">
                                    <field name="sequence"/>
                                    <field name="pdf_field_id"/>
                                    <field name="pdf_field_key" readonly="1"/>
                                    <field name="formula_kind"/>
                                    <field name="formula"/>
                                    <field name="active"/>
                                </list>
                            </field>
                        </page>
                        <page string="Compliance (Guidance)">
                            <field name="compliance_rule_ids">
                                <list editable="bottom">
                                    <field name="sequence"/>
                                    <field name="active"/>
                                    <field name="code"/>
                                    <field name="name"/>
                                    <field name="chapter"/>
                                    <field name="guidance_reference"/>
                                    <field name="rule_type"/>
                                    <field name="target_field_key"/>
                                    <field name="reference_field_key"/>
                                    <field name="threshold_value"/>
                                    <field name="expected_value"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_l10n_ch_salary_certificate_template" model="ir.actions.act_window">
        <field name="name">Salary Certificate Formulas</field>
        <field name="res_model">l10n.ch.salary.certificate.template</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_l10n_ch_salary_certificate_template_search"/>
        <field name="context">{'search_default_filter_active': 1}</field>
    </record>

    <menuitem
        id="menu_l10n_ch_salary_certificate_configuration"
        name="Salary Certificate Formulas"
        parent="hr.menu_hr_employee_payroll"
        action="action_l10n_ch_salary_certificate_template"
        sequence="90"
    />
</odoo>

<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_employee_form_l10n_ch_salary_certificate" model="ir.ui.view">
        <field name="name">hr.employee.form.l10n.ch.salary.certificate</field>
        <field name="model">hr.employee</field>
        <field name="inherit_id" ref="hr.view_employee_form"/>
        <field name="arch" type="xml">
            <xpath expr="//div[@name='button_box']" position="inside">
                <button
                    name="action_open_salary_certificates"
                    type="object"
                    string="Salary Certificates"
                    class="oe_stat_button"
                    icon="fa-file-text-o"
                />
            </xpath>
            <xpath expr="//header" position="inside">
                <button
                    name="action_open_generate_salary_certificate_wizard"
                    type="object"
                    string="Generate Salary Certificate"
                    class="oe_highlight"
                    groups="payroll.group_payroll_user,payroll.group_payroll_manager"
                />
            </xpath>
            <xpath expr="//field[@name='work_email']" position="after">
                <field name="needs_salary_certificate" groups="payroll.group_payroll_user,payroll.group_payroll_manager"/>
            </xpath>
        </field>
    </record>
</odoo>

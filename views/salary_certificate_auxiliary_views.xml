    <record id="view_l10n_ch_salary_certificate_compliance_rule_form" model="ir.ui.view">
        <field name="name">l10n.ch.salary.certificate.compliance.rule.form</field>
        <field name="model">l10n.ch.salary.certificate.compliance.rule</field>

    <record id="view_l10n_ch_salary_certificate_compliance_preset_search" model="ir.ui.view">
        <field name="name">l10n.ch.salary.certificate.compliance.rule.preset.search</field>
        <field name="model">l10n.ch.salary.certificate.compliance.rule.preset</field>

                <field name="rule_type"/>
                <filter name="filter_chapter_i" string="Chapter I" domain="[('chapter', '=', 'chapter_i')]"/>
                <filter name="filter_chapter_ii" string="Chapter II" domain="[('chapter', '=', 'chapter_ii')]"/>
                <filter name="filter_active" string="Active" domain="[('active', '=', True)]"/>
                <separator/>
                <filter name="group_by_template" string="Template" context="{'group_by': 'template_id'}"/>
                <filter name="group_by_chapter" string="Chapter" context="{'group_by': 'chapter'}"/>
            </search>
        </field>
    </record>

    <record id="action_l10n_ch_salary_certificate_compliance_rule" model="ir.actions.act_window">
        <field name="name">Compliance Rules</field>
        <field name="res_model">l10n.ch.salary.certificate.compliance.rule</field>

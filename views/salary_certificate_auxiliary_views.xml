<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_l10n_ch_salary_certificate_pdf_field_tree" model="ir.ui.view">
        <field name="name">l10n.ch.salary.certificate.pdf.field.tree</field>
        <field name="model">l10n.ch.salary.certificate.pdf.field</field>
        <field name="arch" type="xml">
            <list string="Salary Certificate PDF Fields" default_order="docversion,sequence,id">
                <field name="sequence"/>
                <field name="docversion"/>
                <field name="code"/>
                <field name="section"/>
                <field name="label"/>
                <field name="required_in_template"/>
                <field name="active"/>
            </list>
        </field>
    </record>

    <record id="view_l10n_ch_salary_certificate_pdf_field_form" model="ir.ui.view">
        <field name="name">l10n.ch.salary.certificate.pdf.field.form</field>
        <field name="model">l10n.ch.salary.certificate.pdf.field</field>
        <field name="arch" type="xml">
            <form string="Salary Certificate PDF Field">
                <sheet>
                    <group>
                        <group>
                            <field name="sequence"/>
                            <field name="docversion"/>
                            <field name="code"/>
                            <field name="section"/>
                        </group>
                        <group>
                            <field name="label"/>
                            <field name="required_in_template"/>
                            <field name="active"/>
                        </group>
                    </group>
                    <group string="Guidance">
                        <field name="help_text"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_l10n_ch_salary_certificate_pdf_field_search" model="ir.ui.view">
        <field name="name">l10n.ch.salary.certificate.pdf.field.search</field>
        <field name="model">l10n.ch.salary.certificate.pdf.field</field>
        <field name="arch" type="xml">
            <search string="Salary Certificate PDF Fields">
                <field name="docversion"/>
                <field name="code"/>
                <field name="section"/>
                <field name="label"/>
                <filter name="filter_required" string="Required" domain="[('required_in_template', '=', True)]"/>
                <filter name="filter_optional" string="Optional" domain="[('required_in_template', '=', False)]"/>
                <filter name="filter_active" string="Active" domain="[('active', '=', True)]"/>
                <separator/>
                <filter name="group_by_docversion" string="Docversion" context="{'group_by': 'docversion'}"/>
                <filter name="group_by_section" string="Section" context="{'group_by': 'section'}"/>
            </search>
        </field>
    </record>

    <record id="action_l10n_ch_salary_certificate_pdf_field" model="ir.actions.act_window">
        <field name="name">PDF Fields</field>
        <field name="res_model">l10n.ch.salary.certificate.pdf.field</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_l10n_ch_salary_certificate_pdf_field_search"/>
        <field name="context">{'search_default_filter_active': 1}</field>
    </record>

    <record id="view_l10n_ch_salary_certificate_formula_tree" model="ir.ui.view">
        <field name="name">l10n.ch.salary.certificate.formula.tree</field>
        <field name="model">l10n.ch.salary.certificate.formula</field>
        <field name="arch" type="xml">
            <list string="Salary Certificate Formulas" default_order="sequence,id">
                <field name="sequence"/>
                <field name="template_id"/>
                <field name="pdf_field_id"/>
                <field name="formula_kind"/>
                <field name="active"/>
            </list>
        </field>
    </record>

    <record id="view_l10n_ch_salary_certificate_formula_form" model="ir.ui.view">
        <field name="name">l10n.ch.salary.certificate.formula.form</field>
        <field name="model">l10n.ch.salary.certificate.formula</field>
        <field name="arch" type="xml">
            <form string="Salary Certificate Formula">
                <sheet>
                    <group>
                        <group>
                            <field name="sequence"/>
                            <field name="template_id"/>
                            <field name="pdf_field_id"/>
                            <field name="pdf_field_key" readonly="1"/>
                            <field name="label" readonly="1"/>
                        </group>
                        <group>
                            <field name="formula_kind"/>
                            <field name="active"/>
                        </group>
                    </group>
                    <group string="Formula">
                        <field name="formula" widget="text"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_l10n_ch_salary_certificate_formula_search" model="ir.ui.view">
        <field name="name">l10n.ch.salary.certificate.formula.search</field>
        <field name="model">l10n.ch.salary.certificate.formula</field>
        <field name="arch" type="xml">
            <search string="Salary Certificate Formulas">
                <field name="template_id"/>
                <field name="pdf_field_id"/>
                <field name="formula_kind"/>
                <filter name="filter_active" string="Active" domain="[('active', '=', True)]"/>
                <filter name="filter_inactive" string="Inactive" domain="[('active', '=', False)]"/>
                <separator/>
                <filter name="group_by_template" string="Template" context="{'group_by': 'template_id'}"/>
                <filter name="group_by_kind" string="Formula Kind" context="{'group_by': 'formula_kind'}"/>
            </search>
        </field>
    </record>

    <record id="action_l10n_ch_salary_certificate_formula" model="ir.actions.act_window">
        <field name="name">Formulas</field>
        <field name="res_model">l10n.ch.salary.certificate.formula</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_l10n_ch_salary_certificate_formula_search"/>
        <field name="context">{'search_default_filter_active': 1}</field>
    </record>


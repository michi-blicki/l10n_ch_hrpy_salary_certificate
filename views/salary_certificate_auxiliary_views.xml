    <record id="view_l10n_ch_salary_certificate_audit_log_tree" model="ir.ui.view">
        <field name="name">l10n.ch.salary.certificate.audit.log.tree</field>
        <field name="model">l10n.ch.salary.certificate.audit.log</field>
        <field name="arch" type="xml">
            <list string="Salary Certificate Audit Log" default_order="event_at desc,id desc" create="false" delete="false" edit="false">
                <field name="event_at"/>
                <field name="action"/>
                <field name="certificate_id_ref"/>
                <field name="certificate_name"/>
                <field name="employee_id"/>
                <field name="year"/>
                <field name="state_before"/>
                <field name="details"/>
            </list>
        </field>
    </record>

    <record id="view_l10n_ch_salary_certificate_audit_log_form" model="ir.ui.view">
        <field name="name">l10n.ch.salary.certificate.audit.log.form</field>
        <field name="model">l10n.ch.salary.certificate.audit.log</field>
        <field name="arch" type="xml">
            <form string="Salary Certificate Audit Log" create="false" edit="false" delete="false">
                <sheet>
                    <group>
                        <group>
                            <field name="event_at"/>
                            <field name="action"/>
                            <field name="certificate_model"/>
                            <field name="certificate_id_ref"/>
                            <field name="certificate_name"/>
                        </group>
                        <group>
                            <field name="employee_id"/>
                            <field name="year"/>
                            <field name="state_before"/>
                        </group>
                    </group>
                    <group string="Details">
                        <field name="details"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_l10n_ch_salary_certificate_audit_log_search" model="ir.ui.view">
        <field name="name">l10n.ch.salary.certificate.audit.log.search</field>
        <field name="model">l10n.ch.salary.certificate.audit.log</field>
        <field name="arch" type="xml">
            <search string="Salary Certificate Audit Log">
                <field name="event_at"/>
                <field name="action"/>
                <field name="employee_id"/>
                <field name="year"/>
                <filter name="filter_archived" string="Archived" domain="[('action', '=', 'archived')]"/>
                <filter name="filter_deleted" string="Deleted" domain="[('action', '=', 'deleted')]"/>
                <separator/>
                <filter name="group_by_action" string="Action" context="{'group_by': 'action'}"/>
                <filter name="group_by_employee" string="Employee" context="{'group_by': 'employee_id'}"/>
                <filter name="group_by_year" string="Year" context="{'group_by': 'year'}"/>
            </search>
        </field>
    </record>

    <record id="action_l10n_ch_salary_certificate_audit_log" model="ir.actions.act_window">

                            <field name="template_id"/>
                            <field name="code"/>
                            <field name="name"/>
                        </group>
                        <group>
                            <field name="chapter"/>
                            <field name="guidance_reference"/>
                            <field name="rule_type"/>
                            <field name="target_field_key"/>
                            <field name="reference_field_key"/>
                            <field name="threshold_value"/>
                            <field name="expected_value"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_l10n_ch_salary_certificate_compliance_rule_search" model="ir.ui.view">
